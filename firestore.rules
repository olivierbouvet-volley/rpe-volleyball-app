rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /players/{id} {
      allow read, write: if isAuthenticated();
      match /testSessions/{sid} { allow read, write: if isAuthenticated(); }
      match /stats/{sid} { allow read, write: if isAuthenticated(); }
    }
    match /checkins/{id} { allow read, write: if isAuthenticated(); }
    match /checkIns/{id} { allow read, write: if isAuthenticated(); }
    match /rpe/{id} { allow read, write: if isAuthenticated(); }
    match /rpe_data/{id} { allow read, write: if isAuthenticated(); }
    match /rpeHistory/{id} { allow read, write: if isAuthenticated(); }
    match /menstrualCycle/{id} { allow read, write: if isAuthenticated(); }
    match /dailySymptoms/{id} { allow read, write: if isAuthenticated(); }
    match /cycleProfiles/{id} { allow read, write: if isAuthenticated(); }
    match /cycleConfig/{id} { allow read, write: if isAuthenticated(); }
    match /trainingRecommendations/{id} { allow read, write: if isAuthenticated(); }
    match /trainingRecommendationsHistory/{id} { allow read, write: if isAuthenticated(); }
    match /healthAlerts/{id} { allow read, write: if isAuthenticated(); }
    match /injuries/{id} { allow read, write: if isAuthenticated(); }
    match /pains/{id} { allow read, write: if isAuthenticated(); }
    match /doctorAppointments/{id} { allow read, write: if isAuthenticated(); }
    match /kineRequests/{id} { allow read, write: if isAuthenticated(); }
    match /restPeriods/{id} { allow read, write: if isAuthenticated(); }
    match /rest_periods/{id} { allow read, write: if isAuthenticated(); }
    match /teamSettings/{id} { allow read, write: if isAuthenticated(); }
    match /fcmTokens/{id} { allow read, write: if isAuthenticated(); }
    match /notifications/{id} { allow read, write: if isAuthenticated(); }
    match /urgent_messages/{id} { allow read, write: if isAuthenticated(); }
    match /stats/{id} { allow read, write: if isAuthenticated(); }
    match /schedules/{id} {
      allow read, write: if isAuthenticated();
      match /days/{dateKey} { allow read, write: if isAuthenticated(); }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
